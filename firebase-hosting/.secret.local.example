# Copy this file to `.secret.local` in this same `firebase-hosting` folder.
# Do not commit `.secret.local`; it is ignored by git.
#
# Local checkout requires a Stripe test secret key.
STRIPE_SECRET_KEY=sk_test_paste_local_sandbox_key_here

# Use the Stripe CLI local webhook secret when testing webhook delivery:
# stripe listen --forward-to http://127.0.0.1:5001/threedlocalprint/us-central1/stripeWebhook
STRIPE_WEBHOOK_SECRET=whsec_paste_local_webhook_secret_here

# Optional for local order notification email testing through Gmail SMTP.
# Emails sent from local Stripe test webhooks include "(test)" in the subject.
SMTP_USER=service@3dlocalprint.com
SMTP_PASS=paste_google_app_password_here

# Production secrets should be set in Firebase Secret Manager, not committed:
# firebase functions:secrets:set STRIPE_SECRET_KEY
# firebase functions:secrets:set STRIPE_WEBHOOK_SECRET
# firebase functions:secrets:set SMTP_USER
# firebase functions:secrets:set SMTP_PASS
