{
  "functions": {
    "source": "functions"
  },
  "firestore": {
    "rules": "firestore.rules"
  },
  "storage": {
    "rules": "storage.rules"
  },
  "hosting": {
    "public": "public",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "rewrites": [
      {
        "source": "/api/create-checkout-session",
        "function": {
          "functionId": "createCheckoutSession",
          "region": "us-central1"
        }
      },
      {
        "source": "/api/organization-checkout/request",
        "function": {
          "functionId": "submitOrganizationCheckoutRequest",
          "region": "us-central1"
        }
      },
      {
        "source": "/api/organization-checkout/verify",
        "function": {
          "functionId": "verifyOrganizationCheckout",
          "region": "us-central1"
        }
      },
      {
        "source": "/api/admin/organization-checkout/requests",
        "function": {
          "functionId": "manageOrganizationCheckoutRequests",
          "region": "us-central1"
        }
      },
      {
        "source": "/api/admin/organization-checkout/certificate",
        "function": {
          "functionId": "downloadOrganizationCertificate",
          "region": "us-central1"
        }
      },
      {
        "source": "/api/stripe/webhook",
        "function": {
          "functionId": "stripeWebhook",
          "region": "us-central1"
        }
      },
      {
        "source": "/api/public/order",
        "function": {
          "functionId": "getPublicOrder",
          "region": "us-central1"
        }
      },
      {
        "source": "/api/public/order-receipt-link",
        "function": {
          "functionId": "getPublicOrderReceiptLink",
          "region": "us-central1"
        }
      },
      {
        "source": "/api/public/agreement",
        "function": {
          "functionId": "getPublicAgreement",
          "region": "us-central1"
        }
      },
      {
        "source": "/api/public/agreement/accept-checkout",
        "function": {
          "functionId": "acceptAgreementAndCreateCheckoutSession",
          "region": "us-central1"
        }
      },
      {
        "source": "/api/admin/agreements/create-default",
        "function": {
          "functionId": "createDefaultWebsiteServicesAgreement",
          "region": "us-central1"
        }
      },
      {
        "source": "/api/admin/agreements/create",
        "function": {
          "functionId": "createWebsiteServicesAgreement",
          "region": "us-central1"
        }
      },
      {
        "source": "/api/admin/agreements/update",
        "function": {
          "functionId": "updateWebsiteServicesAgreement",
          "region": "us-central1"
        }
      },
      {
        "source": "/api/admin/agreements/delete",
        "function": {
          "functionId": "deleteWebsiteServicesAgreement",
          "region": "us-central1"
        }
      },
      {
        "source": "/api/admin/agreements/send-email",
        "function": {
          "functionId": "sendAgreementEmail",
          "region": "us-central1"
        }
      },
      {
        "source": "/api/model-link-quote-requests",
        "function": {
          "functionId": "submitModelLinkQuoteRequest",
          "region": "us-central1"
        }
      },
      {
        "source": "/api/public/model-link-quote-request",
        "function": {
          "functionId": "getPublicModelLinkQuoteRequest",
          "region": "us-central1"
        }
      },
      {
        "source": "/api/admin/orders/resend-email",
        "function": {
          "functionId": "resendOrderNotification",
          "region": "us-central1"
        }
      },
      {
        "source": "/api/admin/orders/resend-customer-email",
        "function": {
          "functionId": "resendCustomerOrderEmail",
          "region": "us-central1"
        }
      },
      {
        "source": "/api/admin/orders/delete-test-order",
        "function": {
          "functionId": "deleteTestOrder",
          "region": "us-central1"
        }
      },
      {
        "source": "/api/admin/orders/cancel",
        "function": {
          "functionId": "cancelOrder",
          "region": "us-central1"
        }
      },
      {
        "source": "/api/admin/orders/close",
        "function": {
          "functionId": "closeOrder",
          "region": "us-central1"
        }
      },
      {
        "source": "**",
        "destination": "/index.html"
      }
    ]
  }
}
