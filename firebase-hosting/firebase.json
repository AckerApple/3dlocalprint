{
  "functions": {
    "source": "functions"
  },
  "storage": {
    "rules": "storage.rules"
  },
  "hosting": {
    "public": "public",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "rewrites": [
      {
        "source": "/api/create-checkout-session",
        "function": {
          "functionId": "createCheckoutSession",
          "region": "us-central1"
        }
      },
      {
        "source": "/api/stripe/webhook",
        "function": {
          "functionId": "stripeWebhook",
          "region": "us-central1"
        }
      },
      {
        "source": "/api/public/order",
        "function": {
          "functionId": "getPublicOrder",
          "region": "us-central1"
        }
      },
      {
        "source": "/api/public/order-receipt-link",
        "function": {
          "functionId": "getPublicOrderReceiptLink",
          "region": "us-central1"
        }
      },
      {
        "source": "/api/admin/orders/resend-email",
        "function": {
          "functionId": "resendOrderNotification",
          "region": "us-central1"
        }
      },
      {
        "source": "/api/admin/orders/resend-customer-email",
        "function": {
          "functionId": "resendCustomerOrderEmail",
          "region": "us-central1"
        }
      },
      {
        "source": "/api/admin/orders/delete-test-order",
        "function": {
          "functionId": "deleteTestOrder",
          "region": "us-central1"
        }
      },
      {
        "source": "**",
        "destination": "/index.html"
      }
    ]
  }
}
