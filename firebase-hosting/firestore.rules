rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null && request.auth.token.email is string;
    }

    function isAdmin() {
      return signedIn()
        && exists(/databases/$(database)/documents/admins/list)
        && request.auth.token.email in get(/databases/$(database)/documents/admins/list).data.items;
    }

    match /products/list {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /model_link_quote_requests/{requestId} {
      allow read, write: if isAdmin();
    }

    match /customers/{customerId} {
      allow read, write: if isAdmin();
    }

    match /{collection}/{document=**} {
      // Integration credentials and budgets are managed only through authenticated functions.
      allow read, write: if !(collection in ["order_integrations", "checkout_links", "checkout_link_admin", "order_reference_index", "checkout_rate_limits"]) && isAdmin();
    }
  }
}
