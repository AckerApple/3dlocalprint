{
  "name": "3dlocalprint",
  "version": "1.0.27",
  "description": "[gh-pages display](https://ackerapple.github.io/3dlocalprint/)",
  "private": true,
  "type": "module",
  "scripts": {
    "build:html": "tsc -p tsconfig.build-html.json && node scripts/build-html.js",
    "start": "node scripts/start-local.js",
    "dev": "node scripts/dev-sites.js",
    "dev:local": "npm run build:html && vite --host 0.0.0.0 --port 5173 --mode localprint",
    "dev:pet": "npm run build:html && vite --host 0.0.0.0 --port 5174 --mode pet",
    "dev:full": "node scripts/dev-local.js",
    "dev:vite": "npm run dev:local",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "bump": "npm version patch --no-git-tag-version",
    "build": "npm run build:local && npm run build:pet",
    "build:local": "npm run build:html && vite build --mode localprint",
    "build:pet": "npm run build:html && vite build --mode pet",
    "preview": "npm run preview:local",
    "preview:local": "vite preview --port 4173 --outDir dist/3dlocalprint",
    "preview:pet": "vite preview --port 4174 --outDir dist/3dpetprint",
    "deploy": "npm run bump && npm run build && git add . && git commit -m \"deploy\" && git push"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AckerApple/3dlocalprint.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/AckerApple/3dlocalprint/issues"
  },
  "homepage": "https://github.com/AckerApple/3dlocalprint#readme",
  "devDependencies": {
    "@types/node": "^24.3.1",
    "typescript": "^5.9.2",
    "vite": "^6.4.1"
  },
  "dependencies": {
    "@zxing/browser": "^0.1.5",
    "firebase": "^12.7.0",
    "qr-scanner": "^1.4.2",
    "taggedjs": "file:../../web/taggedjs/main/dist"
  }
}
