{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM"],
    "allowJs": true,
    "checkJs": false,
    "strict": false,
    "skipLibCheck": true,
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "rootDir": ".",
    "outDir": ".build-html",
    "declaration": false,
    "sourceMap": false
  },
  "include": [
    "src/page-generators/**/*.ts",
    "scripts/html.core.js"
  ]
}
